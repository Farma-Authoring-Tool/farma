<div class="fixed bottom-6 right-6" data-controller="fab">
  <div class="relative">
    <button data-action="click->fab#toggle">
      <%= helpers.icon(:button_default, class:"text-green-400 hover:text-green-500")%>
    </button>

    <div data-fab-target="menu" class="absolute bottom-14 right-0 flex flex-col gap-2 hidden">
      <% @actions.each do |action| %>
        <%= link_to action[:url], class: "flex items-center gap-2 px-3 py-3 rounded-full shadow bg-green-300 hover:bg-green-400 transition" do %>
          <span><%= action[:icon] %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
