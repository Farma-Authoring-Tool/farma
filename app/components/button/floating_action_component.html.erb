<div class="fixed bottom-6 right-6">
  <div data-controller="dropdown">
    <button data-action="click->dropdown#toggle">
      <%= helpers.icon(:button_default, class: "text-gray-600 hover:text-gray-800") %>
    </button>

    <div data-dropdown-target="menu" class="absolute bottom-12 right-0 flex flex-col items-start gap-1 hidden bg-white rounded-lg shadow-lg border border-gray-200 p-2">
      <% @actions.each do |action| %>
        <%= link_to action[:url], class: "text-left text-sm font-semibold text-green-700 px-2 py-1 hover:bg-green-100 w-40 rounded" do %>
          <%= action[:text] %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
