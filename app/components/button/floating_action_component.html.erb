<div data-controller="dropdown">
  <button data-action="click->dropdown#toggle">
    <%= helpers.icon(:button_default, class: "text-gray-600 hover:text-gray-800") %>
  </button>

  <div data-dropdown-target="menu" class="absolute bottom-12 right-0 flex flex-col items-start gap-2 hidden bg-white rounded-lg shadow-lg border border-gray-200">
    <% @actions.each do |action| %>
      <%= link_to action[:url], class: "text-center text-sm font-semibold text-green-300 px-6 py-1 hover:bg-green-200 w-40 rounded" do %>
        <%= action[:text] %>
      <% end %>
    <% end %>
  </div>
</div>
