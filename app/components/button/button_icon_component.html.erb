<% @actions.each do |action| %>
    <% icon = helpers.icon(action[:icon], class: action[:class]) %>

    <% if action[:type] == :button %>
        <%= button_to action[:url], method: action[:method], data: { confirm: "Tem certeza?" } do %>
            <%= icon %>
        <% end %>
    <% else %>
        <%= link_to action[:url] do %>
            <%= icon %>
        <% end %>
    <% end %>
<% end %>
