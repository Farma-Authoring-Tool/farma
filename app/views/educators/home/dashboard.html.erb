<% provide :title, t('.title') %>
<% provide :head_title, t('.title') %>

<h1 class="text-2xl font-semibold text-gray-500 mb-4"><%= t('.welcome') %>
  <span class="text-2xl font-bold text-green-500"> <%= t('.span') %></span>
</h1>

<section class="border border-gray-300 rounded-md p-5">
  <h2 class="text-xl font-semibold text-gray-500 mt-2 mb-2 border-b border-gray-300"><%= t('.los.recents') %></h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= render partial: "educators/los/lo", collection: @los, as: :lo %>
  </div>

  <div class="flex justify-center itens-center">
    <%= render "educators/los/empty" unless @los.any? %>
  </div>

</section>
