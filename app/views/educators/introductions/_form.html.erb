<%= form_with(model: [:educators, @lo, @introduction], local: true) do |f| %>
  <%= f.input :title %>
  <%= f.input :description, type: :text_area %>

  <div class="flex gap-6">
    <%= f.checkbox :public %>
  </div>    

  <div class="flex items-center">
    <%= f.submit class: "w-full" %>
  </div>
<% end %>
