<div class="my-10 p-4 shadow-lg">
  <div class="flex items-center justify-between w-full">
    <h2 class="font-semibold text-lg text-blue-950 flex-1 text-center flex items-center justify-center">
      <%= icon(:introduction, class: "text-blue-950 mr-2 h-10") %>
      <%= introduction.title %>
    </h2>

    <div class="flex items-center space-x-2">
      <%= button_icon(
        actions: [
            { url: educators_lo_introduction_path(@lo, introduction), method: :delete, icon: :trash, class:"text-gray-400 hover:text-red-500", type: :button },
            { url: edit_educators_lo_introduction_path(@lo, introduction), icon: :edit, class:"text-gray-400 hover:text-green-500", type: :link },
            { url: duplicate_educators_lo_introduction_path(@lo, introduction), icon: :duplicable, class:"text-gray-400 hover:text-blue-500", type: :button }
          ]
        ) %>
      </div>
  </div>

  <p class="text-gray-600 m-10 text-justify p-x"><%= truncate_html(introduction.description.html_safe, length: 400) %></p>
</div>