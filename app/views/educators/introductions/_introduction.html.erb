<div class="my-6 p-4 shadow-sm">
    <h2 class="font-semibold text-lg flex justify-center text-gray-800"><%= introduction.title %></h2>
    <p class="text-gray-600 mt-1"><%= introduction.description %></p>

    <div class="flex justify-end mt-4 space-x-4">
      <%= link_to edit_educators_lo_introduction_path(@lo, introduction) do %>
        <%= icon(:edit, class: "text-green-700 cursor-pointer") %>
      <% end %>

      <%= link_to educators_lo_introduction_path(@lo, introduction), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } do %>
        <%= icon(:trash, class: "text-red-700 cursor-pointer") %>
      <% end %>
    </div>
</div>