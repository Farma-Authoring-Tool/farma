<div class="my-10 p-4 shadow-lg">
    <h2 class="font-semibold text-lg flex justify-center items-center text-blue-950">
      <%= icon(:introduction, class: "text-blue-950 mr-2 h-10") %>
      <%= introduction.title %>
    </h2>

    <p class="text-gray-600 m-10 text-justify p-x"><%= truncate_html(introduction.description.html_safe, length: 400) %></p>

    <div class="flex justify-start space-x-4 mt-2">
      <%= link_to edit_educators_lo_introduction_path(@lo, introduction) do %>
        <%= icon(:edit, class: "text-gray-500 hover:text-green-700 cursor-pointer") %>
      <% end %>

      <%= link_to educators_lo_introduction_path(@lo, introduction), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } do %>
        <%= icon(:trash, class: "text-gray-500 hover:text-red-700 cursor-pointer") %>
      <% end %>
    </div>
</div>