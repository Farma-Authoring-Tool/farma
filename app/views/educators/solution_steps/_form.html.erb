<%= form_with(model: [:educators, @lo, @exercise, @solution_step], local: true) do |f| %>
  <%= f.input :title %>

  <%= f.input :description, type: :text_area, data: { controller: "tinymce" } %>

  <%= f.input :response %>
  
  <%= f.input :decimal_digits %>

  <%= f.checkbox :draft %>   

  <div class="flex items-center">
    <%= f.submit class: "w-full" %>
  </div>
<% end %>