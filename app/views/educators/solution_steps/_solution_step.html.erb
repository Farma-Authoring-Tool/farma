<div class="my-10 p-4 shadow-lg">
    <h2 class="font-semibold text-lg flex justify-center items-center text-green-500">
      <%= icon(:solution_step, class: "text-green-500 mr-2") %>
      <%= solution_step.title %>
    </h2>

    <p class="text-gray-600 m-10"><%= truncate_html(solution_step.description.html_safe, length: 400) %></p>

    <div class="flex justify-start space-x-4 mb-4 mt-2">
      <%= link_to edit_educators_lo_exercise_solution_step_path(@lo, @exercise, solution_step) do %>
        <%= icon(:edit, class: "text-gray-500 hover:text-green-700 cursor-pointer") %>
      <% end %>

      <%= link_to educators_lo_exercise_solution_step_path(@lo, @exercise, solution_step), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } do %>
        <%= icon(:trash, class: "text-gray-500 hover:text-red-700 cursor-pointer") %>
      <% end %>

      <%= link_to new_educators_lo_exercise_solution_step_tip_path(@lo, @exercise, solution_step)  do %>
        <%= icon(:tips, class: "text-gray-500 hover:text-blue-700 cursor-pointer") %>
      <% end %>
    </div>

    <%= render partial: "educators/tips/tip", collection: solution_step.tips.order(:number_attempts), as: :tip, locals: { solution_step: solution_step } %>
</div>