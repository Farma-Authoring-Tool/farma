<hr class="border-gray-300 mt-3">

<div class="flex flex-col text-gray-500 gap-2">
    <div class="flex items-center text-green-800 mt-2">  
         <%= icon(:tips, class:"h-4") %>
        <h1 class="font-bold"><%= tip.title %></h1>
    </div>
    <h1 class="text-sm"><%= truncate(tip.description.html_safe, length: 80) %></h1>

    <div class="flex items-center justify-between">
        <h1 class="text-sm"><%=t(".number_attempts")%> <%= tip.number_attempts %></h1>
        <div class="flex space-x-2 items-center">
            <%= button_icon(
                actions: [
                    { url: educators_lo_exercise_solution_step_tip_path(@lo, @exercise, solution_step, tip), method: :delete, icon: :trash, class:"text-gray-400 hover:text-red-500", type: :button },
                    { url: edit_educators_lo_exercise_solution_step_tip_path(@lo, @exercise, solution_step, tip), icon: :edit, class:"text-gray-400 hover:text-green-500", type: :link },
                    { url: duplicate_educators_lo_exercise_solution_step_tip_path(@lo, @exercise, solution_step, tip), icon: :duplicable, class:"text-gray-400 hover:text-blue-500", type: :button }
                ]
            ) %>
        </div>
    </div>
</div>