<%= form_with(model: [:educators, @lo], local: true) do |f| %>
  <%= f.input :title %>
  <%= f.input :description, type: :text_area %>
  <%= f.file_input :picture, accept: Lo::ACCEPTED_PICTURE_TYPES_TEXT %>

  <div class="flex gap-6">
    <%= f.checkbox :accessible %>
    <%= f.checkbox :duplicable %>
  </div>

  <div class="flex items-center">
    <%= f.submit class: "w-full" %>
  </div>
<% end %>
