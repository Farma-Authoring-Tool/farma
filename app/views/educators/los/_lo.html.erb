<div class="block">
  <%= link_to educators_lo_path(lo) do %>
    <%= image_tag lo.picture_url, class: "brightness-75 w-full h-24 object-cover object-top rounded-t-md" %>
  <% end %>

  <div class="p-4 bg-white shadow-md rounded-b-md border border-gray-200">
    <div class="flex justify-between items-center">
      <h1 class="text-md text-gray-800 md:text-lg font-semibold"><%= truncate_html(lo.title, length: 20) %></h1>

      <div class="flex space-x-2 items-center ">
        <%= button_icon(
          actions: [
            { url: educators_lo_path(lo), method: :delete, icon: :trash, class:"text-gray-400 hover:text-red-500", type: :button },
            { url: edit_educators_lo_path(lo), icon: :edit, class:"text-gray-400 hover:text-green-500", type: :link },
            { url: duplicate_educators_lo_path(lo), icon: :duplicable, class:"text-gray-400 hover:text-blue-500", type: :button }
          ]
        ) %>
      </div>
    </div>

    <%= truncate_html(lo.description, length: 50) %>
  </div>
</div>