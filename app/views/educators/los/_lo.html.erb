<div class="rounded-xl border border-gray-200 bg-white p-2">
  <div class="w-full overflow-hidden rounded-t-lg bg-white aspect-[4/3]">
    <%= link_to educators_lo_path(lo) do %>
      <%= image_tag lo.picture_url, class: "w-full h-full object-cover" %>
    <% end %>
  </div>

  <div class="p-4 bg-white shadow-md rounded-b-lg border border-gray-200">
    <div class="flex justify-between items-center">
      <h1 class="text-md text-gray-800 md:text-lg font-semibold"><%= lo.title.truncate(20) %></h1>

      <div class="flex space-x-2 items-center">
        <%= link_to edit_educators_lo_path(lo) do %>
          <%= icon(:edit, class: "text-gray-400 hover:text-green-500") %>
        <% end %>

        <%= button_to duplicate_educators_lo_path(lo), method: :post do %>
          <%= icon(:duplicable, class: "text-gray-400 mt-1 hover:text-blue-500") %>
        <% end %>

        <%= link_to educators_lo_path(lo), data: { turbo_method: :delete, turbo_confirm: t("prompts.confirm") } do %>
          <%= icon(:trash, class: "text-gray-400 hover:text-red-500") %>
        <% end %>
      </div>
    </div>

    <%= truncate_html(lo.description.html_safe, length: 50) %>
  </div>
</div>
