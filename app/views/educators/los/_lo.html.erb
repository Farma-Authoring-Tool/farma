<div class="relative group w-full h-50 rounded-md overflow-hidden">
  <%= image_tag lo.picture_url, class: "w-full h-full object-cover object-top brightness-75 rounded-md" %>

  <div class="absolute inset-0 bg-black/50 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
    <%= link_to educators_lo_path(lo) do %> 
      <h1 class="text-lg font-semibold text-white"><%= lo.title %></h1>
    <% end %>

    <div class="flex justify-between items-center">
      <p class="text-white text-sm">
        <%= truncate(lo.description, length: 80) %>
      </p>

      <div class="flex space-x-2 items-center">
        <%= link_to educators_lo_path(lo), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } do %>
          <%= icon(:trash, class: "text-red-400 hover:text-red-600 cursor-pointer") %>
        <% end %>

        <%= link_to edit_educators_lo_path(lo) do %>
          <%= icon(:edit, class: "text-green-400 hover:text-green-600 cursor-pointer") %>
        <% end %>
      </div>
    </div>
  </div>
</div>
