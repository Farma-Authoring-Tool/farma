<% provide :title, t('.title_nav') %>
<% provide :head_title, t('.title') %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <%= render partial: "educators/los/lo", collection: @los, as: :lo %>
</div>

<div class="flex justify-center itens-center">
  <%= render "educators/los/empty" unless @los.any? %>
</div>

<div class="fixed bottom-8 right-8">
  <%= link_to new_educators_lo_path do %>
    <%= icon(:buttonCreate, class: 'w-9 h-9 text-green-600') %>
  <% end %>
</div>
