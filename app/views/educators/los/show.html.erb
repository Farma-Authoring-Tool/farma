<%= render 'educators/sections/title' %>

<h1 class="text-2xl font-bold text-gray-700"><%= truncate_html(@lo.title.html_safe, length: 80) %></h1>
<p class="mt-2 text-gray-600"><%= truncate_html(@lo.description.html_safe, length: 400) %></p>

<% if @lo.picture.attached? %>
  <%= image_tag url_for(@lo.picture), class: "mt-4 w-full h-64 object-cover object-top rounded-md" %>
<% else %>
  <%= image_tag "bg/default_lo.png", class: "mt-4 w-full h-64 object-cover object-top rounded-md" %>
<% end %>

<%= render partial: "educators/introductions/introduction", collection: @lo.introductions.order(created_at: :asc), as: :introduction %>

<%= render partial: "educators/exercises/exercise", collection: @lo.exercises.order(created_at: :asc), as: :exercise %>

<div class="fixed bottom-6 right-6">
  <%= button(
    actions: [
      { url: new_educators_lo_introduction_path(@lo), text: "Introdução" },
      { url: new_educators_lo_exercise_path(@lo), text: "Exercício" }
    ]
  ) %>
</div>

