<%= render 'educators/sections/title' %>

<p class="mt-2 text-gray-600"><%= @lo.description.truncate(300)%> </p>

<% if @lo.picture.attached? %>
  <%= image_tag url_for(@lo.picture), class: "mt-4 w-full h-86 object-cover rounded-md" %>
<% else %>
  <%= image_tag "bg/default_lo.png", class: "mt-4 w-full h-86 object-cover rounded-md" %>
<% end %>

<%= render partial: "educators/introductions/introduction", collection: @lo.introductions.order(created_at: :asc), as: :introduction %>

<%= render partial: "educators/exercises/exercise", collection: @lo.exercises.order(created_at: :asc), as: :exercise %>

<div class="fixed bottom-6 right-6">
  <%= button(
    actions: [
      { url: new_educators_lo_introduction_path(@lo), text: t(".create_introduction") },
      { url: new_educators_lo_exercise_path(@lo), text: t(".create_exercise") }
    ]
  ) %>
</div>

