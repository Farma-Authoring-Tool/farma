<div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 md:p-6">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-3 flex-1">
      <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold bg-emerald-50 text-emerald-700">
          <%= Exercise.model_name.human %>
      </span>

      <h3 class="text-lg font-semibold text-gray-900"><%= exercise.title %></h3>
      <div><%= exercise.description.html_safe %></div>
    </div>

    <div class="flex items-start gap-2">
      <%= link_to edit_educators_lo_exercise_path(@lo, exercise) do %>
        <%= icon(:edit, class: "text-gray-400 hover:text-green-500") %>
      <% end %>

      <%= button_to duplicate_educators_lo_exercise_path(@lo, exercise), method: :post do %>
        <%= icon(:duplicable, class: "text-gray-400 hover:text-blue-500 mb-3") %>
      <% end %>

      <%= link_to educators_lo_exercise_path(@lo, exercise), data: { turbo_method: :delete, turbo_confirm: t("prompts.confirm") } do %>
        <%= icon(:trash, class: "text-gray-400 hover:red-blue-500") %>
      <% end %>
    </div>
  </div>

  <div class="mt-5">
    <%= link_to t(".view"),
                educators_lo_exercise_solution_steps_path(@lo, exercise),
                class: "bg-green-100 text-green-700 text-xs py-1 px-2 rounded-sm hover:text-white hover:bg-green-500 mt-12" %>
  </div>
</div>
