<div class="my-10 p-4 shadow-lg">
    <h2 class="font-semibold text-lg flex justify-center items-center text-green-800">
      <%= icon(:exercise, class: "text-green-800 mr-2") %>
      <%= exercise.title %>
    </h2>

    <p class="text-gray-600 m-10"><%= truncate_html(exercise.description.html_safe, length: 400)%></p>

    <div class="flex justify-start items-center space-x-4">
      <%= link_to edit_educators_lo_exercise_path(@lo, exercise) do %>
        <%= icon(:edit, class: "text-gray-500 hover:text-green-700 cursor-pointer") %>
      <% end %>

      <%= link_to educators_lo_exercise_path(@lo, exercise), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } do %>
        <%= icon(:trash, class: "text-gray-500 hover:text-red-700 cursor-pointer") %>
      <% end %>

      <%= link_to t(".view"),
        educators_lo_exercise_solution_steps_path(@lo, exercise),
        class: "bg-green-200 text-green-500 text-xs py-1 px-2 rounded-sm hover:text-white hover:bg-green-500" %>
    </div>
</div>