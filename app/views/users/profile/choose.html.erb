<section class="h-screen bg-cover bg-center bg-no-repeat"
         style="background-image: url(<%= asset_path('bg/authentication.png') %>); ">

  <div class="h-screen flex flex-col md:flex-row gap-8 justify-center items-center">

    <%= link_to students_root_path, class: "block rounded-xl bg-white p-8 w-72 text-center hover:bg-green-100" do %>
      <h2 class="text-xl font-bold text-gray-800 mb-2">Sou estudante</h2>
      <p class="text-gray-500 text-base">Acesse o painel de estudante</p>
    <% end %>

    <%= link_to educators_root_path, class: "block rounded-xl bg-white p-8 w-72 text-center hover:bg-green-100" do %>
      <h2 class="text-xl font-bold text-gray-800 mb-2">Sou educador</h2>
      <p class="text-gray-500 text-base">Acesse o painel de educador</p>
    <% end %>

  </div>
</section>
