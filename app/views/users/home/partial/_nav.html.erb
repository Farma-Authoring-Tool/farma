<div class="flex justify-between gap-4 mt-4 mx-6">
  <%= image_tag "logo/farma-gray.png", alt: "Logo FARMA", class: "w-8 h-8 " %>

  <div class="flex gap-4">
    <%= link_to root_path, class: "text-white hover:text-blue-600" do %>
      <%= icon(:home) %>
    <% end %>

    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-white hover:text-red-600" do %>
      <%= icon(:logout) %>
    <% end %>
  </div>
</div> 