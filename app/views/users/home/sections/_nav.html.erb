<div class="flex justify-between gap-4 mt-4 mx-6">
  <%= image_tag "farma.png", alt: "Logo FARMA", class: "w-14 h-14 " %>

  <div class="flex gap-4">
    <%= link_to root_path, class: "text-gray-600 hover:text-blue-600" do %>
      <%= render 'users/home/sections/icon/root' %>
    <% end %>

    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-600 hover:text-red-600" do %>
      <%= render 'users/home/sections/icon/logout' %>
    <% end %>
  </div>
</div>