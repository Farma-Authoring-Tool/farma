<div class="bg-black">   
  <%= image_tag 'background.png', alt: 'Background Image', class: "absolute top-0 left-0 w-full h-full object-cover z-0 opacity-10" %>

  <div class="relative text-white min-h-screen bg-cover bg-center flex flex-col items-center justify-center text-center px-4 py-8" %>
    <%= render 'home/sections/nav' %>
    
    <div class="flex mx-24">
      <%= render 'home/sections/logo' %>
    </div>
    <h1 class="text-xl sm:text-2xl md:text-3xl font-semibold text-gray-300 mb-4">
      <%= t('home.title')%>
    </h1>

    <h2 class="max-w-2xl text-2xl sm:text-base text-gray-300 mb-8">
      <%= t('home.subtitle')%>
    </h2>                                                                           
  </div>
</div>
