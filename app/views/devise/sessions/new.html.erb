<% provide(:head_title, t(".title")) %>
<% provide(:head_subtitle, t(".subtitle")) %>

<%= form_with(model: resource, as: resource_name, url: session_path(resource_name)) do |f| %>

  <%= f.input :email, type: :email %>
  <%= f.input :password, type: :password %>

  <%= link_to t('.forgot_password'), new_user_password_path, class: "flex text-xs md:text-sm text-green-500 justify-end mb-3" %>

  <div class="flex items-center">
    <%= f.submit t(".submit"), class: "w-full" %>
  </div>
<% end %>
