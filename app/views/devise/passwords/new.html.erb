<% provide(:head_title, t(".forgot_your_password")) %>
<% provide(:head_subtitle, t(".message")) %>

<%= form_with(model: resource, as: resource_name, url: password_path(resource_name)) do |f| %>

  <%= f.input :email, type: :email, label: false, autofocus: true %>

  <%= link_to "Lembrou sua senha?", new_user_session_path, class: "flex text-green-500 justify-end mb-3" %>

  <div class="flex items-center">
    <%= f.submit t(".send_me_reset_password_instructions"), class: "w-full" %>
  </div>

<% end %>
