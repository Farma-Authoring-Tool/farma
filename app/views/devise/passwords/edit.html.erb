<% provide(:head_title, t(".confirm_new_password")) %>
<% provide(:head_subtitle, t(".subtitle")) %>

<%= form_with(model: resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <%= f.full_error :reset_password_token %>

  <%= f.input :password, type: :password, hint: (t("devise.shared.minimum_password_length.other", count: @minimum_password_length) if @minimum_password_length) %>
  <%= f.input :password_confirmation, type: :password %>

  <div class="flex items-center">
    <%= f.submit t(".submit"), class: "w-full" %>
  </div>

<% end %>
