<% provide(:head_title, t("devise.passwords.edit.change_my_password")) %>

<%= rc "flash/message" %>

<%= form_with(model: resource, as: resource_name, url: password_path(resource_name), method: :put, builder: TailwindFormBuilder, html: { class: "space-y-4" }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <%= f.tw_password_field :password, hint: (t("devise.shared.minimum_password_length.other", count: @minimum_password_length) if @minimum_password_length) %>

  <%= f.tw_password_field :password_confirmation %>

  <%= rc "button/primary", text: t("devise.passwords.edit.change_password"), type: "submit" %>
<% end %>
