<%= image_tag 'authentication/reset_password.png', alt: "Reset password", width: "300" %>

<h1 class="flex text-center">
   <%= t('devise.passwords.new.forgot_your_password') %>
</h1>

<p>
   <%= t('devise.passwords.new.message') %>
</p>

<%= link_to t('devise.passwords.new.forgot_your_password'), edit_password_url(@resource, reset_password_token: @token), class: "button" %>