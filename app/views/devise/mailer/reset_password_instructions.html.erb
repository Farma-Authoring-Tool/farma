<%= image_tag 'authentication/reset_password.png',
  alt: "Reset password",
  width: "300",
  style: "display: block; margin: 0 auto 24px auto;" %>

<h1 style="
  text-align: center;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 16px;
  color: #000000;">
  <%= t('devise.passwords.new.forgot_your_password') %>
</h1>

<p style="
  text-align: center;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px;
  color: #555555;
  margin-bottom: 24px;">
  <%= t('devise.passwords.new.message') %>
</p>

<%= link_to t('devise.passwords.new.forgot_your_password'),
  edit_password_url(@resource, reset_password_token: @token),
  style: '
    display: inline-block;
    width: 100%;
    background-color: #22c55e;
    color: #ffffff;
    font-weight: bold;
    padding: 0.5rem 0;
    border-radius: 0.375rem;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease;
  ' %>
