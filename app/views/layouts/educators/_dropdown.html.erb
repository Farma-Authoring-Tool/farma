<div data-controller="dropdown" data-action="click@window->dropdown#close">
  <div class="flex items-center space-x-3 rtl:space-x-reverse md:space-x-0 md:order-2">

    <%= button_tag id: 'user-menu-button',
                   data: { action: 'click->dropdown#toggle' },
                   class: 'flex items-center text-sm pe-1 font-medium rounded-full text-green-700 md:me-0',
                   type: 'button' do %>
      <span class="sr-only">Menu</span>

      <%= icon(:user, class: "text-white mr-1")%>

      <span class="max-sm:hidden text-white font-medium">
        <%= current_user.name %>
      </span>
    <% end %>
  </div>

  <div data-dropdown-target="menu" class="absolute top-14 right-8 z-50 my-4 hidden list-none rounded-lg bg-white text-base text-green-800 shadow divide-y divide-gray-200">
    <div class="px-4 py-3 text-sm">
      <span class="block"><%= current_user.name %></span>
      <span class="block truncate"><%= current_user.email %></span>
    </div>

    <ul class="py-2" aria-labelledby="user-menu-button">
      <% links = [
        { text: t('links.profile'), url: "#"},
        { text: t('links.choose_profile'), url: users_choose_profile_path },
        { text: t('links.sign_out'), url: destroy_user_session_path, data: { turbo_method: :delete } }
      ]%>

      <% links.each do |link| %>
        <li>
          <%= link_to link[:text], link[:url], class: "block px-4 py-2 text-green-700 ./text-sm hover:bg-green-200 rounded-lg", data: link.fetch(:data, {}) %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
