<!DOCTYPE html>
<html>
<head>
  <%= render "layouts/shared/head" %>
</head>

<body class="bg-gray-50">

<div data-controller="sidebar">
  <%= render 'layouts/educators/header' %>
  <%= render 'layouts/educators/sidebar' %>
</div>

<main class="h-screen px-4 py-24 lg:ml-42">

  <div class="mb-4 border-b border-gray-200 pb-2">
    <h1 class="text-3xl font-bold text-gray-500"><%= yield(:head_title) %></h1>
  </div>

  <%= render 'layouts/breadcrumbs/breadcrumbs' %>

  <div class="mx-auto mt-4 rounded-lg border border-gray-200 bg-white p-6">

    <%= render Flash::MessageComponent.new %>

    <h2 class="mb-2 text-2xl font-bold tracking-tight text-gray-900">
      <%= yield(:content_title) %>
    </h2>

    <%= yield %>

    
  </div>
</main>
</body>
</html>
