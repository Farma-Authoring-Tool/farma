<!DOCTYPE html>
<html>
<%= render "layouts/shared/head" %>
<body>
<main class="h-screen bg-cover bg-center bg-no-repeat"
      style="background-image: url(<%= asset_path('bg/authentication.png') %>); ">

  <div class="h-screen flex flex-col gap-8 justify-center items-center">

    <%= link_to root_path do %>
      <%= image_tag 'logo/farma-gray.png',
                    alt: 'Logo FARMA',
                    class: "h-12 transform transition duration-300 ease-in-out hover:-translate-y-2" %>
    <% end %>

    <div>
      <%= yield %>
    </div>
  </div>

</main>
</body>
</html>
